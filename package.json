{
  "name": "mastre-gaming",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A launcher that collects browser games from separate GitHub repos into one static site.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:games": "node scripts/build-games.mjs",
    "build:all": "npm run build && node scripts/build-games.mjs --examples",
    "preview": "node scripts/serve.mjs",
    "check-game": "node scripts/check-game.mjs",
    "test": "node scripts/test-pipeline.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
